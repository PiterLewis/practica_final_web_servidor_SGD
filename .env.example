PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bildyapp

# JWT
JWT_SECRET=cambia_este_secreto_minimo_32_caracteres
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=cambia_este_refresh_secreto_distinto_al_access
JWT_REFRESH_EXPIRES=7d

# Bcrypt
BCRYPT_ROUNDS=10

# Rate limiting
RATE_LIMIT_MAX=200

# CORS
CORS_ORIGIN=*

# Cloudinary (subida de firmas y PDFs)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=usuario_smtp
SMTP_PASS=password_smtp
SMTP_FROM=BildyApp <no-reply@bildyapp.test>

# Slack (logging de errores 5xx)
SLACK_WEBHOOK_URL=

# PostgreSQL + Prisma (capa complementaria, opcional)
# Compatible con Supabase: el pooler (6543) para DATABASE_URL, conexión directa (5432) para migraciones
DATABASE_URL=postgresql://usuario:password@host:6543/postgres?pgbouncer=true&schema=public
DIRECT_URL=postgresql://usuario:password@host:5432/postgres?schema=public
